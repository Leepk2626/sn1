                        { text: "吸收阳光", correct: false, voice: "吸收阳光主要是叶子的作用。" }
                    ]
                }
            ],
            3: [ // Level 3: 科学达人综合挑战 (6 Questions)
                {
                    question: "“菠菜”和“凤仙花”的根中间都有一条粗粗的主根，它们属于什么根？",
                    emoji: "🌱",
                    options: [
                        { text: "主根", correct: true, voice: "完全正确！它们都属于主根。" },
                        { text: "须根", correct: false, voice: "不对哦，须根是像胡须一样的根。" }
                    ]
                },
                {
                    question: "“苔藓”和“羊齿植物”有什么共同特征？",
                    emoji: "☘️",
                    options: [
                        { text: "它们都是不会开花的植物", correct: true, voice: "非常棒！苔藓和羊齿植物都不会开花。" },
                        { text: "它们都结出甜甜的果实", correct: false, voice: "不对哦，它们连花都不开，不会结果实。" }
                    ]
                },
                {
                    question: "“木槿 (大红花)”和“九重葛”都属于什么植物？",
                    emoji: "🌸",
                    options: [
                        { text: "会开花的植物", correct: true, voice: "答对啦！它们都会开出美丽的花朵。" },
                        { text: "不会开花的植物", correct: false, voice: "不对哦，它们是常见的开花植物。" }
                    ]
                },
                {
                    question: "“菜心”的茎容易被折断，而且是绿色的，属于什么茎？",

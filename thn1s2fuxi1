                        { text: "长得更高更大", correct: false, voice: "不对哦，没有根植物就无法生存了。" }
                    ]
                },
                {
                    question: "观察图片中的木瓜树，叶子、花、茎、根统称为什么？",
                    emoji: "🌴",
                    options: [
                        { text: "植物的各个部分（器官）", correct: true, voice: "太棒了！它们都是植物不可或缺的器官！" },
                        { text: "植物的影子", correct: false, voice: "不对哦！" }
                    ]
                }
            ]
        };

        // Tab switching logic
        function switchTab(tab) {
            playSound('click');
            currentTab = tab;
            const learnSection = document.getElementById('learnSection');
            const gameSection = document.getElementById('gameSection');
            const tabLearnBtn = document.getElementById('tabLearnBtn');
            const tabGameBtn = document.getElementById('tabGameBtn');

            if (tab === 'learn') {
                learnSection.classList.remove('hidden');
                gameSection.classList.add('hidden');
                tabLearnBtn.className = "px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 bg-white text-emerald-700 shadow-sm";
                tabGameBtn.className = "px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 text-emerald-800 hover:text-emerald-900";
            } else {
                learnSection.classList.add('hidden');
                gameSection.classList.remove('hidden');
                tabGameBtn.className = "px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 bg-white text-emerald-700 shadow-sm";
                tabLearnBtn.className = "px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 text-emerald-800 hover:text-emerald-900";
                startLevel(currentLevel);
            }
        }

        // Level controller
        function startLevel(lvl) {
            playSound('click');
            currentLevel = lvl;
            currentQuestionIdx = 0;

            // Update Level Buttons active state
            [1, 2, 3].forEach(l => {
                const btn = document.getElementById(`lvl${l}Btn`);
                if (l === lvl) {
                    btn.className = "px-4 py-2 rounded-xl font-bold text-xs sm:text-sm bg-emerald-500 text-white shadow bouncy-btn";
                } else {
                    btn.className = "px-4 py-2 rounded-xl font-bold text-xs sm:text-sm bg-gray-100 text-gray-600 hover:bg-emerald-100 bouncy-btn";
                }
            });

            const titles = {
                1: "关卡 1：植物特征分类 (5题)",
                2: "关卡 2：器官与功能 (5题)",
                3: "关卡 3：科学达人大挑战 (6题)"
            };
            document.getElementById('gameTitle').innerText = titles[lvl];
            document.getElementById('levelBadge').innerText = `关卡 ${lvl} / 3`;

            renderQuestion();
        }

        // Render current question
        function renderQuestion() {
            const questions = levelData[currentLevel];
            const qData = questions[currentQuestionIdx];
            const gameContent = document.getElementById('gameContent');
            const nextBtn = document.getElementById('nextBtn');
            const progressText = document.getElementById('progressText');
            const progressBar = document.getElementById('progressBar');

            nextBtn.classList.add('hidden');
            progressText.innerText = `问题 ${currentQuestionIdx + 1} / ${questions.length}`;

            // Progress bar length
            const progressPct = ((currentQuestionIdx) / questions.length) * 100;
            progressBar.style.width = `${progressPct}%`;

            // Narrate question automatically
            speakText(qData.question);

            gameContent.innerHTML = `
                <div class="text-center max-w-lg mx-auto">
                    <div class="text-6xl mb-4 transform hover:scale-110 transition duration-300 inline-block cursor-pointer" title="点击重新朗读题目" onclick="speakText('${qData.question}')">
                        ${qData.emoji}
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-slate-800 mb-6 font-cartoon leading-snug">
                        ${qData.question}
                    </h3>

                    <div class="grid grid-cols-1 gap-3 text-left">
                        ${qData.options.map((opt, idx) => `
                            <button onclick="checkAnswer(${idx})" class="option-btn bg-emerald-50 hover:bg-emerald-100 border-2 border-emerald-200 text-emerald-950 font-bold p-4 rounded-2xl transition-all duration-200 flex items-center justify-between bouncy-btn group">
                                <span class="text-base sm:text-lg">${opt.text}</span>
                                <span class="w-8 h-8 rounded-full bg-white border border-emerald-300 flex items-center justify-center text-emerald-600 font-bold group-hover:bg-emerald-500 group-hover:text-white transition">
                                    ${idx + 1}
                                </span>
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function checkAnswer(selectedIdx) {
            const questions = levelData[currentLevel];
            const qData = questions[currentQuestionIdx];
            const selectedOpt = qData.options[selectedIdx];
            const optionBtns = document.querySelectorAll('.option-btn');

            // Disable all buttons after choice
            optionBtns.forEach(btn => btn.onclick = null);

            if (selectedOpt.correct) {
                // Correct answer
                playSound('correct');
                speakText(selectedOpt.voice);
                optionBtns[selectedIdx].classList.remove('bg-emerald-50', 'border-emerald-200');
                optionBtns[selectedIdx].classList.add('bg-green-500', 'text-white', 'border-green-600', 'pulse-green');
                
                score += 10;
                document.getElementById('globalScore').innerText = score;

            } else {
                // Incorrect answer
                playSound('wrong');
                speakText(selectedOpt.voice);
                optionBtns[selectedIdx].classList.remove('bg-emerald-50', 'border-emerald-200');
                optionBtns[selectedIdx].classList.add('bg-red-400', 'text-white', 'border-red-500', 'shake');

                // Highlight correct option
                qData.options.forEach((opt, idx) => {
                    if (opt.correct) {
                        optionBtns[idx].classList.add('bg-green-100', 'border-green-400', 'text-green-900');
                    }
                });
            }

            // Show next button
            const nextBtn = document.getElementById('nextBtn');
            nextBtn.classList.remove('hidden');
        }

        function nextQuestion() {
            playSound('click');
            const questions = levelData[currentLevel];
            currentQuestionIdx++;

            if (currentQuestionIdx < questions.length) {
                renderQuestion();
            } else {
                // Update full level progress
                document.getElementById('progressBar').style.width = '100%';

                // Next Level or Victory
                if (currentLevel < 3) {
                    startLevel(currentLevel + 1);
                } else {
                    showVictoryModal();
                }
            }
        }

        function showVictoryModal() {
            playSound('victory');
            speakText("恭喜你！成功通过全部关卡！你太棒啦！");
            document.getElementById('finalScore').innerText = score;
            document.getElementById('victoryModal').classList.remove('hidden');
            triggerConfetti();
        }

        function restartGame() {
            playSound('click');
            document.getElementById('victoryModal').classList.add('hidden');
            score = 0;
            document.getElementById('globalScore').innerText = score;
            startLevel(1);
        }

        // Particle Confetti FX
        function triggerConfetti() {
            const canvas = document.getElementById('confettiCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const colors = ['#22c55e', '#eab308', '#ec4899', '#3b82f6', '#a855f7'];

            for (let i = 0; i < 120; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    vy: Math.random() * 3 + 2,
                    vx: Math.random() * 2 - 1
                });
            }

            let animationFrame;
            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    ctx.fillStyle = p.color;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                });

                if (particles.some(p => p.y < canvas.height)) {
                    animationFrame = requestAnimationFrame(render);
                } else {
                    cancelAnimationFrame(animationFrame);
                }
            }
            render();
        }

        // Audio unlock on user touch/click
        window.addEventListener('click', () => {
            initAudio();
        }, { once: true });
    </script>

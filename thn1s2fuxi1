<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>一年级科学：神奇的植物世界</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=ZCOOL+KuaiLe&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', 'Microsoft YaHei', sans-serif;
            background-color: #f0fdf4;
            background-image: radial-gradient(#bbf7d0 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }
        .font-cartoon {
            font-family: 'ZCOOL KuaiLe', cursive, sans-serif;
        }
        .bouncy-btn {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .bouncy-btn:hover {
            transform: translateY(-2px);
        }
        .bouncy-btn:active {
            transform: scale(0.92);
        }
        .card-hover {
            transition: all 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px -6px rgba(16, 185, 129, 0.25);
        }
        .shake {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }
        @keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }
        .pulse-green {
            animation: pulse-green 0.8s infinite alternate;
        }
        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            100% { box-shadow: 0 0 0 12px rgba(34, 197, 94, 0); }
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #dcfce7;
        }
        ::-webkit-scrollbar-thumb {
            background: #4ade80;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between selection:bg-emerald-200">

    <!-- Top Banner & Audio Controls -->
    <header class="bg-gradient-to-r from-emerald-500 via-green-500 to-teal-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-white/20 p-2 rounded-2xl backdrop-blur-md text-2xl sm:text-3xl">
                    🌿
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-cartoon tracking-wide text-yellow-200 drop-shadow">一年级科学：植物的世界</h1>
                    <p class="text-xs sm:text-sm text-emerald-100 hidden sm:block">观察特征 • 理解器官 • 关卡挑战游戏</p>
                </div>
            </div>

            <!-- Score & Sound Controls -->
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-700/60 px-3 py-1.5 rounded-full flex items-center space-x-2 border border-emerald-400/40 shadow-inner">
                    <span class="text-yellow-300 text-lg">⭐</span>
                    <span id="globalScore" class="font-bold text-lg text-white">0</span>
                    <span class="text-xs text-emerald-200">分</span>
                </div>
                <button id="soundToggleBtn" onclick="toggleMute()" class="bg-white/20 hover:bg-white/30 text-white p-2.5 rounded-full transition bouncy-btn" title="声音开关">
                    <i id="soundIcon" class="fas fa-volume-up text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto px-4 py-6 flex-grow w-full">
        <!-- Navigation Tabs -->
        <div class="flex justify-center mb-8">
            <div class="bg-emerald-100/80 p-1.5 rounded-2xl flex space-x-2 border border-emerald-200 shadow-inner">
                <button id="tabLearnBtn" onclick="switchTab('learn')" class="px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 bg-white text-emerald-700 shadow-sm">
                    <i class="fas fa-book-open text-emerald-500"></i>
                    <span>📖 学习天地</span>
                </button>
                <button id="tabGameBtn" onclick="switchTab('game')" class="px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base transition-all duration-300 flex items-center space-x-2 text-emerald-800 hover:text-emerald-900">
                    <i class="fas fa-gamepad text-amber-500"></i>
                    <span>🎮 闯关互动游戏 (每关5题+)</span>
                </button>
            </div>
        </div>

        <!-- SECTION 1: LEARN MODE -->
        <div id="learnSection" class="space-y-8">
            <!-- Voice assistant tip -->
            <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                <div class="flex items-center space-x-3">
                    <span class="text-3xl">💡</span>
                    <div>
                        <h3 class="font-bold text-amber-900 text-sm sm:text-base">学习小提示：</h3>
                        <p class="text-xs sm:text-sm text-amber-800">点击小喇叭 🔊 可以朗读课文！仔细阅读植物的特征，打好基础再去参加闯关游戏吧！</p>
                    </div>
                </div>
            </div>

            <!-- Learning Module Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Card 1: 叶子 -->
                <div class="bg-white rounded-3xl p-5 border-2 border-emerald-100 shadow-md card-hover relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center space-x-2">
                            <span class="bg-emerald-500 text-white px-3 py-1 rounded-xl text-xs font-bold">特征 1</span>
                            <h2 class="text-xl font-bold text-emerald-900 font-cartoon">🍃 叶子 (平行脉与网状脉)</h2>
                        </div>
                        <button onclick="speakText('叶子上的叶脉可分为平行脉和网状脉。茅草和洋葱是平行脉，木槿和凤仙花是网状脉。')" class="text-emerald-600 hover:text-emerald-800 p-2 rounded-full hover:bg-emerald-50 transition bouncy-btn" title="朗读">
                            <i class="fas fa-volume-high text-xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 text-sm mb-4">植物的叶子上有<b>叶脉</b>，主要分为两种：</p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-emerald-50/80 p-3 rounded-2xl border border-emerald-200/60 text-center">
                            <div class="text-3xl mb-1">🌿</div>
                            <h3 class="font-bold text-emerald-800 text-sm">平行脉</h3>
                            <p class="text-xs text-gray-500 mt-1">叶脉平行排列</p>
                            <span class="inline-block mt-2 bg-emerald-200 text-emerald-800 text-[11px] px-2 py-0.5 rounded-full font-bold">例: 茅草、洋葱、水稻</span>
                        </div>
                        <div class="bg-green-50/80 p-3 rounded-2xl border border-green-200/60 text-center">
                            <div class="text-3xl mb-1">🍁</div>
                            <h3 class="font-bold text-green-800 text-sm">网状脉</h3>
                            <p class="text-xs text-gray-500 mt-1">叶脉像网一样交错</p>
                            <span class="inline-block mt-2 bg-green-200 text-green-800 text-[11px] px-2 py-0.5 rounded-full font-bold">例: 凤仙花、木槿、玫瑰</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: 花 -->
                <div class="bg-white rounded-3xl p-5 border-2 border-pink-100 shadow-md card-hover relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center space-x-2">
                            <span class="bg-pink-500 text-white px-3 py-1 rounded-xl text-xs font-bold">特征 2</span>
                            <h2 class="text-xl font-bold text-pink-900 font-cartoon">🌸 花 (开花与不开花)</h2>
                        </div>
                        <button onclick="speakText('不是所有的植物都会开花。会开花的植物有木槿、羊角豆、九重葛；不会开花的植物有鸟巢蕨、羊齿植物、苔藓。')" class="text-pink-600 hover:text-pink-800 p-2 rounded-full hover:bg-pink-50 transition bouncy-btn" title="朗读">
                            <i class="fas fa-volume-high text-xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 text-sm mb-4">根据是否开花，植物可以分类为：</p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-pink-50/80 p-3 rounded-2xl border border-pink-200/60 text-center">
                            <div class="text-3xl mb-1">🌺</div>
                            <h3 class="font-bold text-pink-800 text-sm">会开花的植物</h3>
                            <p class="text-xs text-gray-500 mt-1">会长出漂亮的花朵</p>
                            <span class="inline-block mt-2 bg-pink-200 text-pink-800 text-[11px] px-2 py-0.5 rounded-full font-bold">木槿、羊角豆、九重葛</span>
                        </div>
                        <div class="bg-rose-50/80 p-3 rounded-2xl border border-rose-200/60 text-center">
                            <div class="text-3xl mb-1">🪴</div>
                            <h3 class="font-bold text-rose-800 text-sm">不会开花的植物</h3>
                            <p class="text-xs text-gray-500 mt-1">一生都不开花</p>
                            <span class="inline-block mt-2 bg-rose-200 text-rose-800 text-[11px] px-2 py-0.5 rounded-full font-bold">鸟巢蕨、羊齿植物、苔藓</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: 茎 -->
                <div class="bg-white rounded-3xl p-5 border-2 border-amber-100 shadow-md card-hover relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center space-x-2">
                            <span class="bg-amber-500 text-white px-3 py-1 rounded-xl text-xs font-bold">特征 3</span>
                            <h2 class="text-xl font-bold text-amber-900 font-cartoon">🪵 茎 (木质茎与草质茎)</h2>
                        </div>
                        <button onclick="speakText('植物的茎可分为木质茎和草质茎。木质茎坚硬，比如榴莲树和木槿；草质茎柔软，比如向日葵和菜心。')" class="text-amber-600 hover:text-amber-800 p-2 rounded-full hover:bg-amber-50 transition bouncy-btn" title="朗读">
                            <i class="fas fa-volume-high text-xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 text-sm mb-4">植物的茎支撑着植株，主要分为：</p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-amber-50/80 p-3 rounded-2xl border border-amber-200/60 text-center">
                            <div class="text-3xl mb-1">🌳</div>
                            <h3 class="font-bold text-amber-800 text-sm">木质茎 (坚硬)</h3>
                            <p class="text-xs text-gray-500 mt-1">粗壮坚硬，不容易折断</p>
                            <span class="inline-block mt-2 bg-amber-200 text-amber-800 text-[11px] px-2 py-0.5 rounded-full font-bold">榴莲树、木槿树</span>
                        </div>
                        <div class="bg-yellow-50/80 p-3 rounded-2xl border border-yellow-200/60 text-center">
                            <div class="text-3xl mb-1">🌻</div>
                            <h3 class="font-bold text-amber-800 text-sm">草质茎 (柔软)</h3>
                            <p class="text-xs text-gray-500 mt-1">绿色柔软，水分较多</p>
                            <span class="inline-block mt-2 bg-yellow-200 text-amber-900 text-[11px] px-2 py-0.5 rounded-full font-bold">向日葵、菜心</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: 根 -->
                <div class="bg-white rounded-3xl p-5 border-2 border-orange-100 shadow-md card-hover relative overflow-hidden">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center space-x-2">
                            <span class="bg-orange-500 text-white px-3 py-1 rounded-xl text-xs font-bold">特征 4</span>
                            <h2 class="text-xl font-bold text-orange-900 font-cartoon">🥕 根 (主根与须根)</h2>
                        </div>
                        <button onclick="speakText('植物的根分为主根和须根。主根中间有一条明显粗大的主根，如凤仙花和菠菜；须根像一把胡须，如洋葱和茅草。')" class="text-orange-600 hover:text-orange-800 p-2 rounded-full hover:bg-orange-50 transition bouncy-btn" title="朗读">
                            <i class="fas fa-volume-high text-xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 text-sm mb-4">根深入泥土中，吸收营养和水分：</p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-orange-50/80 p-3 rounded-2xl border border-orange-200/60 text-center">
                            <div class="text-3xl mb-1">🌱</div>
                            <h3 class="font-bold text-orange-800 text-sm">主根</h3>
                            <p class="text-xs text-gray-500 mt-1">中间有一条明显的根</p>
                            <span class="inline-block mt-2 bg-orange-200 text-orange-900 text-[11px] px-2 py-0.5 rounded-full font-bold">凤仙花、菠菜</span>
                        </div>
                        <div class="bg-stone-50/80 p-3 rounded-2xl border border-stone-200/60 text-center">
                            <div class="text-3xl mb-1">🧅</div>
                            <h3 class="font-bold text-stone-800 text-sm">须根</h3>
                            <p class="text-xs text-gray-500 mt-1">许多细根聚集像胡须</p>
                            <span class="inline-block mt-2 bg-stone-200 text-stone-800 text-[11px] px-2 py-0.5 rounded-full font-bold">洋葱、茅草、玉米</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Card 5: 重要性 (Functions) -->
            <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-3xl p-6 border-2 border-emerald-200 shadow-md">
                <div class="flex justify-between items-center mb-6">
                    <div class="flex items-center space-x-3">
                        <span class="text-3xl">⭐</span>
                        <div>
                            <h2 class="text-2xl font-bold text-emerald-900 font-cartoon">植物各部分的重要性（器官功能）</h2>
                            <p class="text-xs sm:text-sm text-emerald-700">叶子、花、茎、根都有非常重要的任务哦！</p>
                        </div>
                    </div>
                    <button onclick="speakText('叶子制造食物，背面的气孔是呼吸器官。花繁殖后代。茎输送食物、水分和养料。根吸收水分和养料，并把植物固定在泥土里。')" class="bg-emerald-600 text-white px-4 py-2 rounded-2xl shadow hover:bg-emerald-700 transition bouncy-btn flex items-center space-x-2 text-sm font-bold">
                        <i class="fas fa-volume-high"></i>
                        <span>朗读全部</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-emerald-100 flex flex-col items-center text-center">
                        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-2xl mb-2">🍃</div>
                        <h3 class="font-bold text-emerald-800">叶子</h3>
                        <span class="text-xs bg-green-100 text-green-800 font-semibold px-2 py-0.5 rounded-full my-1">制造食物</span>
                        <p class="text-xs text-gray-500 mt-1">背面有许多<b>气孔</b>，是植物的呼吸器官。</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-emerald-100 flex flex-col items-center text-center">
                        <div class="w-12 h-12 bg-pink-100 rounded-full flex items-center justify-center text-2xl mb-2">🌸</div>
                        <h3 class="font-bold text-pink-800">花</h3>
                        <span class="text-xs bg-pink-100 text-pink-800 font-semibold px-2 py-0.5 rounded-full my-1">繁殖后代</span>
                        <p class="text-xs text-gray-500 mt-1">能够结出果实和种子，用来繁衍下一代。</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-emerald-100 flex flex-col items-center text-center">
                        <div class="w-12 h-12 bg-amber-100 rounded-full flex items-center justify-center text-2xl mb-2">🪵</div>
                        <h3 class="font-bold text-amber-800">茎</h3>
                        <span class="text-xs bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded-full my-1">输送养料</span>
                        <p class="text-xs text-gray-500 mt-1">支撑植物，并输送水分、食物和养料。</p>
                    </div>

                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-emerald-100 flex flex-col items-center text-center">
                        <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center text-2xl mb-2">🥕</div>
                        <h3 class="font-bold text-orange-800">根</h3>
                        <span class="text-xs bg-orange-100 text-orange-800 font-semibold px-2 py-0.5 rounded-full my-1">吸收水分/固定</span>
                        <p class="text-xs text-gray-500 mt-1">吸收泥土里的水分和养料，固定植物。</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: GAME MODE -->
        <div id="gameSection" class="hidden space-y-6">
            
            <!-- Game Level Selector Banner -->
            <div class="bg-white rounded-3xl p-5 border-2 border-emerald-200 shadow-md flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-emerald-900 font-cartoon">🏆 植物大冒险闯关游戏</h2>
                    <p class="text-xs sm:text-sm text-gray-600">每关包含<b>至少 5 道精选题目</b>，快来挑战获得全三星大满贯吧！</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <button id="lvl1Btn" onclick="startLevel(1)" class="px-4 py-2 rounded-xl font-bold text-xs sm:text-sm bg-emerald-500 text-white shadow bouncy-btn">关卡 1: 植物分类 (5题)</button>
                    <button id="lvl2Btn" onclick="startLevel(2)" class="px-4 py-2 rounded-xl font-bold text-xs sm:text-sm bg-gray-100 text-gray-600 hover:bg-emerald-100 bouncy-btn">关卡 2: 器官功能 (5题)</button>
                    <button id="lvl3Btn" onclick="startLevel(3)" class="px-4 py-2 rounded-xl font-bold text-xs sm:text-sm bg-gray-100 text-gray-600 hover:bg-emerald-100 bouncy-btn">关卡 3: 科学达人 (6题)</button>
                </div>
            </div>

            <!-- Game Card Frame -->
            <div id="gameCanvasCard" class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-200 shadow-lg min-h-[420px] flex flex-col justify-between relative overflow-hidden">
                <!-- Level Indicator Header -->
                <div class="flex justify-between items-center pb-4 border-b border-gray-100">
                    <div class="flex items-center space-x-2">
                        <span id="levelBadge" class="bg-amber-400 text-amber-950 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider">
                            关卡 1 / 3
                        </span>
                        <h3 id="gameTitle" class="text-lg font-bold text-slate-800 font-cartoon">植物特征分类</h3>
                    </div>
                    <div class="flex items-center space-x-1 text-yellow-400 text-xl" id="starsContainer">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-emerald-100 h-2.5 rounded-full overflow-hidden my-2">
                    <div id="progressBar" class="bg-emerald-500 h-full w-0 transition-all duration-300"></div>
                </div>

                <!-- Dynamic Game Content Container -->
                <div id="gameContent" class="py-4 my-auto">
                    <!-- Dynamic content rendered by JS -->
                </div>

                <!-- Bottom Progress / Feedback Bar -->
                <div id="gameFooter" class="pt-4 border-t border-gray-100 flex justify-between items-center text-sm text-gray-500">
                    <span id="progressText" class="font-bold text-emerald-800">问题 1 / 5</span>
                    <button id="nextBtn" onclick="nextQuestion()" class="hidden bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-6 py-2.5 rounded-xl shadow bouncy-btn flex items-center space-x-2">
                        <span>下一题</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

        </div>
    </main>

    <!-- Victory Modal -->
    <div id="victoryModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl p-8 max-w-md w-full text-center shadow-2xl border-4 border-yellow-300 relative transform transition-all animate-bounce-short">
            <div class="text-6xl mb-3">🎉</div>
            <h2 class="text-3xl font-bold font-cartoon text-emerald-800 mb-2">恭喜全部通关！</h2>
            <p class="text-gray-600 mb-6 text-sm">你真棒！成功完成了所有科学关卡挑战，成为了<b>“小小植物科学家”</b>！</p>
            
            <div class="bg-emerald-50 rounded-2xl p-4 mb-6 border border-emerald-100 flex justify-around">
                <div>
                    <span class="text-xs text-gray-500 block">总得分</span>
                    <span id="finalScore" class="text-3xl font-black text-emerald-600">0</span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block">获得勋章</span>
                    <span class="text-3xl">🏅</span>
                </div>
            </div>

            <button onclick="restartGame()" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-bold py-3.5 rounded-2xl shadow-lg hover:brightness-110 transition bouncy-btn text-base">
                🔄 重新开启挑战
            </button>
        </div>
    </div>

    <!-- Canvas for particle confetti -->
    <canvas id="confettiCanvas" class="pointer-events-none fixed inset-0 z-50"></canvas>

    <!-- Footer -->
    <footer class="bg-white border-t border-emerald-100 py-4 mt-8 text-center text-xs text-emerald-700/80">
        <p>一年级科学 (Primary 1 Science) 🌿 植物的特征与重要性 • 互动教学与游戏平台</p>
    </footer>

    <script>
        /* WEB AUDIO API SOUND SYNTHESIZER (No external audio files needed) */
        let audioCtx = null;
        let isMuted = false;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            if (isMuted) return;
            initAudio();
            if (!audioCtx) return;

            const now = audioCtx.currentTime;

            if (type === 'correct') {
                // Cheerful C Major arpeggio
                const notes = [523.25, 659.25, 783.99]; // C5, E5, G5
                notes.forEach((freq, i) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + i * 0.08);
                    gain.gain.setValueAtTime(0.25, now + i * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.25);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + i * 0.08);
                    osc.stop(now + i * 0.08 + 0.25);
                });
            } 
            else if (type === 'wrong') {
                // Low buzz sound
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.linearRampToValueAtTime(110, now + 0.25);

                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start(now);
                osc.stop(now + 0.3);
            }
            else if (type === 'click') {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, now);
                gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.05);
            }
            else if (type === 'victory') {
                // Fanfare melody
                const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.1);
                    gain.gain.setValueAtTime(0.25, now + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + idx * 0.1 + 0.35);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + idx * 0.1);
                    osc.stop(now + idx * 0.1 + 0.35);
                });
            }
        }

        function toggleMute() {
            isMuted = !isMuted;
            const icon = document.getElementById('soundIcon');
            if (isMuted) {
                icon.className = 'fas fa-volume-xmark text-lg text-red-200';
                if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            } else {
                icon.className = 'fas fa-volume-up text-lg';
                playSound('click');
            }
        }

        /* TEXT TO SPEECH (TTS) NARRATION */
        function speakText(text) {
            if (isMuted) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Stop any ongoing speech
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'zh-CN'; // Chinese Mandarin
                utterance.rate = 0.9; // Kids friendly speech speed
                utterance.pitch = 1.1; // Warm pitch
                window.speechSynthesis.speak(utterance);
            }
        }

        /* APP STATE MANAGEMENT & QUESTION DATA (Min 5 questions per level) */
        let currentTab = 'learn';
        let currentLevel = 1;
        let currentQuestionIdx = 0;
        let score = 0;

        // Comprehensive Question Database (5+ per level)
        const levelData = {
            1: [ // Level 1: 植物特征分类 (5 Questions)
